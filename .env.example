# Copy to .env.local. `vercel env pull` writes the same names.
#
# VITE_* values are compiled into the browser bundle and are public identifiers.
# Everything else is a server secret and must never use the VITE_ prefix.

# --- Browser (public) ---
VITE_CLERK_PUBLISHABLE_KEY=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# Local testing stream, used on localhost only. The production ID is in
# src/lib/gtag.ts, so this can never send local traffic to production.
VITE_GA_ID=

# --- Server (secret) ---
CLERK_SECRET_KEY=
# Base64-encoded service account JSON. Issues Firebase sessions, deletes
# categories, and stores rate limits. Writes fail closed without it.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Base64-encoded service account JSON with GA Data API access.
GOOGLE_APPLICATION_CREDENTIALS_JSON=
GA4_PROPERTY_ID=
RESEND_API_KEY=

# --- Server (optional) ---
# Extra origins allowed to present Clerk tokens, comma separated.
AUTHORIZED_PARTIES=
APP_URL=
