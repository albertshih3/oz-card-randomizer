{
  "name": "vite-template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "vite",
    "dev:full": "vercel dev",
    "build": "npm run typecheck && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "npm run typecheck:app && npm run typecheck:api && npm run typecheck:test",
    "typecheck:app": "tsc --noEmit -p tsconfig.json",
    "typecheck:api": "tsc --noEmit -p tsconfig.api.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:rules": "firebase-tools emulators:exec --only firestore --project demo-oz-rules \"vitest run --config vitest.rules.config.ts --globals\"",
    "verify": "npm run lint && npm run typecheck && npm run test:run && vite build",
    "update-changelog": "node scripts/update-changelog.js",
    "prepare": "husky"
  },
  "dependencies": {
    "@clerk/backend": "^3.27.0",
    "@clerk/react": "^6.18.6",
    "@google-analytics/data": "^7.3.0",
    "@heroui/input": "^2.4.33",
    "@heroui/link": "^2.2.26",
    "@heroui/modal": "^2.2.29",
    "@heroui/navbar": "^2.2.30",
    "@heroui/select": "^2.4.33",
    "@heroui/skeleton": "^2.2.18",
    "@heroui/switch": "^2.2.27",
    "@heroui/system": "^2.4.28",
    "@heroui/table": "^2.2.32",
    "@heroui/theme": "^2.4.26",
    "@react-aria/visually-hidden": "^3.9.1",
    "@react-types/shared": "^3.37.0",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "firebase": "^13.2.0",
    "firebase-admin": "^14.5.0",
    "framer-motion": "^14.9.1",
    "lucide-react": "^1.69.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "resend": "^6.37.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^4.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/node": "^30.0.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "firebase-tools": "^15.35.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vercel": "^65.12.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7"
  }
}
