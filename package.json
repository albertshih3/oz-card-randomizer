{
  "name": "vite-template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "vite",
    "dev:full": "vercel dev",
    "build": "npm run typecheck && vite build",
    "lint": "eslint -c .eslintrc.json src api --ext .ts,.tsx",
    "lint:fix": "eslint -c .eslintrc.json src api --ext .ts,.tsx --fix",
    "typecheck": "npm run typecheck:app && npm run typecheck:api && npm run typecheck:test",
    "typecheck:app": "tsc --noEmit -p tsconfig.json",
    "typecheck:api": "tsc --noEmit -p tsconfig.api.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:rules": "firebase-tools emulators:exec --only firestore --project demo-oz-rules \"vitest run --config vitest.rules.config.ts --globals\"",
    "verify": "npm run lint && npm run typecheck && npm run test:run && vite build",
    "update-changelog": "node scripts/update-changelog.js",
    "prepare": "husky"
  },
  "dependencies": {
    "@clerk/backend": "^3.8.4",
    "@clerk/clerk-react": "^5.61.8",
    "@google-analytics/data": "^4.0.0",
    "@heroui/button": "2.2.27",
    "@heroui/chip": "^2.2.22",
    "@heroui/code": "2.2.21",
    "@heroui/dropdown": "2.3.27",
    "@heroui/form": "^2.1.27",
    "@heroui/input": "2.4.28",
    "@heroui/kbd": "2.2.22",
    "@heroui/link": "2.2.23",
    "@heroui/modal": "^2.2.24",
    "@heroui/navbar": "2.2.25",
    "@heroui/radio": "^2.3.27",
    "@heroui/select": "^2.4.28",
    "@heroui/skeleton": "^2.2.17",
    "@heroui/snippet": "2.2.28",
    "@heroui/switch": "2.2.24",
    "@heroui/system": "2.4.23",
    "@heroui/table": "^2.2.27",
    "@heroui/theme": "2.4.23",
    "@heroui/tooltip": "^2.2.24",
    "@react-aria/visually-hidden": "3.8.28",
    "@react-stately/data": "^3.14.1",
    "@react-types/shared": "3.32.1",
    "@vercel/analytics": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^13.2.0",
    "firebase-admin": "^14.5.0",
    "framer-motion": "12.23.24",
    "lucide-react": "^0.555.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.30.4",
    "resend": "^6.12.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "3.2.2",
    "tailwindcss-animate": "^1.0.7",
    "vercel": "^50.44.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.65.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "24.10.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "8.48.0",
    "@typescript-eslint/parser": "8.48.0",
    "@vercel/node": "^5.6.20",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "autoprefixer": "10.4.22",
    "baseline-browser-mapping": "^2.10.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.4.1",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-unused-imports": "4.3.0",
    "firebase-tools": "^15.35.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "lint-staged": "^16.4.0",
    "postcss": "8.5.6",
    "prettier": "3.7.3",
    "tailwindcss": "^3.4.18",
    "typescript": "5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint -c .eslintrc.json --fix",
      "bash -c 'tsc --noEmit'"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
